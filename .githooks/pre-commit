#!/bin/sh
# Integrity gate — block commits carrying obfuscated/injected payloads (see 2026-07-09 postcss incident).
if [ -f frontend/scripts/integrity-guard.mjs ]; then
  node frontend/scripts/integrity-guard.mjs || {
    echo "commit blocked by integrity-guard (frontend/scripts/integrity-guard.mjs)"; exit 1;
  }
fi
# SUM edition gate — a correction or master change must never ship unverified
# (fleet r1.021: Enlil/Odin found the gate existed but nothing invoked it).
if [ -f scripts/exec-summary-verify-sum.mjs ] && [ -f docs/i18n/exec-summary.sum.json ]; then
  node scripts/exec-summary-verify-sum.mjs || {
    echo "commit blocked by exec-summary-verify-sum (SUM edition out of step)"; exit 1;
  }
fi

# Reader-coverage gate — a logographic symbol must never ship without its reading.
# Guards the real risk: a re-translation slipping Han/cuneiform into an edition that
# has no reader (hanja into Korean, a Chinese term inside Vietnamese).
if [ -f scripts/exec-summary-verify-readers.mjs ] && [ -d frontend/public/whitepaper ]; then
  node scripts/exec-summary-verify-readers.mjs || {
    echo "commit blocked by exec-summary-verify-readers (a symbol is shipping unread)"; exit 1;
  }
fi
