# ─────────────────────────────────────────────────────────────────────────────
# eXeL-AI-Polling — Backend environment template
# Copy to `backend/.env` and fill in real values. NEVER commit the real .env.
# Every value here is a PLACEHOLDER — no secrets are stored in the repo.
# Names must match backend/app/config.py (Settings).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL, asyncpg driver) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://polling:polling@localhost:5432/polling_db

# ── Auth0 ────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.exel-ai-polling
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── AI Providers (launch: OpenAI, Grok/xAI, Gemini/Google, Claude/Anthropic) ──
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=openai            # openai | gemini | grok | claude

# ── Real-time STT (Cube 3 — paid: Azure primary, AWS fallback) ───────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Supabase (Realtime + REST) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                       # Fernet key (AES-128) for encrypt/decrypt_payload
SESSION_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development                # development | production
LOG_LEVEL=INFO

# ── Stripe (3 tiers: Free ≤19 · Moderator Paid $11.11 · Cost Split) ──────────
# TEST MODE: leave every key blank → the payment layer runs in test/no-charge mode.
# Fill sk_test_/pk_test_ for Stripe test mode, or the *_LIVE_* vars for production.
# Register the webhook endpoint (POST /api/v1/webhooks/stripe) in the Stripe
# Dashboard, then paste its signing secret into STRIPE_WEBHOOK_SECRET to enable
# signature verification (see backend/app/cubes/cube8_tokens/webhook.py).
# Payouts to the eXeL AI bank account (daily/weekly/monthly) + Stripe Connect for
# incentive/upside routing are configured in the Stripe Dashboard, not here.
STRIPE_SECRET_KEY=                    # sk_test_...  (test mode)
STRIPE_PUBLISHABLE_KEY=               # pk_test_...  (test mode; mirror in frontend)
STRIPE_RESTRICTED_KEY=                # rk_test_...  frontend-safe restricted operations
STRIPE_WEBHOOK_SECRET=                # whsec_...    set after creating the webhook endpoint
STRIPE_LIVE_SECRET_KEY=               # sk_live_...  PRODUCTION — keep out of dev
STRIPE_LIVE_PUBLISHABLE_KEY=          # pk_live_...
STRIPE_LIVE_RESTRICTED_KEY=           # rk_live_...

# ── Session defaults / determinism ───────────────────────────────────────────
DEFAULT_SESSION_EXPIRY_HOURS=24
SESSION_SEED=                         # optional global seed for deterministic session_id (UUID5)

# ── SoI Trinity tokens (♡ 웃 ◬) ──────────────────────────────────────────────
LOGIN_HEART_TOKENS=1.0                # ♡ awarded on join
UNITY_HEART_MULTIPLIER=5.0            # ◬ = 5 × ♡
HUMAN_ENABLED=false                   # flip True when treasury funded (activates 웃 payout)
HUMAN_HOURLY_RATE=7.25                # 웃 baseline (US federal min wage); 웃/min = rate/60
HUMAN_CURRENCY=USD

# ── Cloudflare deployment ────────────────────────────────────────────────────
BEHIND_CLOUDFLARE=false               # enable CF-Connecting-IP extraction
ALLOWED_ORIGINS=                      # comma-separated extra CORS origins
CLOUDFLARE_TURNSTILE_SECRET=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# ── Free tier ────────────────────────────────────────────────────────────────
FREE_TIER_MAX_PARTICIPANTS=19

# ── Cube 10 Simulation Engine access codes (CHANGE THESE in your .env) ────────
CUBE10_ADMIN_CODE=change-me
CUBE10_CHALLENGER_CODE=change-me
