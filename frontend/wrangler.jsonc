{
  "name": "exel-ai-polling",
  "compatibility_date": "2026-02-14",
  // Worker entry: dynamic routes (e.g. /Atlantis-Accords/<hash> short links).
  // With `main` + `assets`, asset-matching requests are served directly and
  // only non-matching requests invoke the worker (which falls back to
  // env.ASSETS.fetch, preserving the SPA behavior below).
  "main": "worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // KV binding for cross-device session + response storage.
  // DISABLED: worker.js (the only code that runs in this Workers Static Assets
  // deploy) never touches env.RESPONSES — the short-link route uses Supabase,
  // and functions/api/responses.js never executes here. A placeholder id makes
  // `wrangler deploy` fail with error 10042, blocking ALL deploys. To re-enable
  // KV: create a namespace in the CF Dashboard, paste its real 32-hex id below,
  // and uncomment. Until then, leave this off so deploys succeed.
  // "kv_namespaces": [{ "binding": "RESPONSES", "id": "<paste-real-32-hex-kv-id>" }]
}
