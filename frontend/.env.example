# ─────────────────────────────────────────────────────────────────────────────
# eXeL-AI-Polling — Frontend environment template
# Copy to `frontend/.env.local` and fill in real values. NEVER commit the real file.
# ONLY NEXT_PUBLIC_* vars are exposed to the browser — put NO secrets here.
# Names must match frontend/lib/constants.ts / lib/api.ts.
# Auth0 dashboard steps: docs/ops/AUTH0_GO_LIVE.md (and /workspace/fleet/auth0-steps.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0 (public client config — safe for the browser) ──────────────────────
NEXT_PUBLIC_AUTH0_DOMAIN=exel-ai-polling.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=H8wuT6P2nfm87bvbRjaegoOliLyhPw4K
# Must match Auth0 API Identifier AND backend AUTH0_API_AUDIENCE exactly:
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.exel-ai-polling

# ── API ──────────────────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (set in CI / Workers Builds when leaving mock mode):
# NEXT_PUBLIC_API_URL=https://exel-ai-polling-api.explore-096.workers.dev/api/v1

# ── Mock mode ────────────────────────────────────────────────────────────────
# Default (unset) = mock/backendless. Set to the literal string "false" to talk to the live API.
# DO NOT set false until Auth0 API Identifier + role claim Action exist (docs/ops/AUTH0_GO_LIVE.md).
# NEXT_PUBLIC_MOCK_MODE=false

# ── Stripe (PUBLISHABLE key only — safe for the browser, never the secret key) ─
# Leave blank → the payment UI runs in test/no-charge mode. Paste your
# pk_test_... (test) or pk_live_... (production) publishable key to enable
# Stripe Checkout / Payment Intents. The SECRET key lives ONLY in backend/.env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
